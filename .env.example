# ============================================
# Environment identifier
# ============================================
# Which environment this config belongs to.
# Used to select the docker-compose behavior and naming (dev | staging | prod)
APP_ENV=dev

# Startup command Keycloak runs.
# Use "start-dev" for local/dev (relaxed HTTP, auto-reload, NOT for production).
# Use "start --optimized" for staging/prod (requires a prior build, stricter checks).
KC_COMMAND=start-dev

# ============================================
# Shared Postgres server (dev only)
# ============================================
# In dev, app-db and Keycloak's DB live as two separate databases inside
# ONE Postgres 16.14 container ("postgres" service in
# infra/docker-compose.yml, profile "dev"), so only one port is exposed.
# DB_ROOT_USER/DB_ROOT_PASSWORD are only used once, on first startup, by
# infra/postgres-init/init-databases.sh to create the APP_DB_* and KC_DB_*
# databases/users below. Not used in staging/prod (DB already exists there).
DB_ROOT_USER=postgres_root

# Never commit real values — keep this only in .env (gitignored).
DB_ROOT_PASSWORD=changeme

# Host port mapped to the shared Postgres container's internal port (5432)
# in dev. Lets you reach it from the host (e.g. psql, a GUI client).
DB_PORT=5432

# ============================================
# Database connection (Keycloak's own DB)
# ============================================
# Hostname Keycloak connects to for its own DB (container-to-container,
# internal port 5432 — not the host-exposed DB_PORT above).
# dev: "postgres" (the Docker Compose service name on the vca-net network).
# staging/prod: the VPS host/IP or internal DNS name of the existing DB.
KC_DB_HOST=postgres

# Name of the database Keycloak will use to store its own data
# (realms, users, clients, sessions, etc.). Must already exist and be empty.
KC_DB_NAME=keycloak_dev

# Database user Keycloak will authenticate with.
# Needs privileges to create/alter/drop tables on first boot.
KC_DB_USERNAME=keycloak_user

# Password for the database user above.
# Never commit real values — keep this only in .env (gitignored).
KC_DB_PASSWORD=changeme

# ============================================
# Keycloak admin bootstrap credentials
# ============================================
# Username for the initial Keycloak admin account.
# Only used the first time the container starts with an empty DB.
KEYCLOAK_ADMIN_USER=admin

# Password for the initial Keycloak admin account.
# Change this immediately after first login in staging/prod.
KEYCLOAK_ADMIN_PASSWORD=changeme

# ============================================
# Network / exposure
# ============================================
# Public hostname Keycloak will be served under.
# Used to build correct redirect URIs and issuer URLs.
# Example: localhost (dev), auth-staging.tudominio.com, auth.tudominio.com
KC_HOSTNAME=localhost

# Host port mapped to Keycloak's internal port (8080).
# Change if 8080 is already taken on the VPS.
KC_PORT=8080

# ============================================
# Application database (backend/POS data)
# ============================================
# Separate from Keycloak's own database — this one stores business data
# (products, sales, inventory, etc.), never IAM/session data.
#
# In dev, this database lives inside the shared "postgres" service in
# infra/docker-compose.yml (profile "dev", Postgres 16.14 in Docker) —
# see the "Shared Postgres server" section above.
# In staging/prod, this database is already deployed on the VPS and
# managed separately — these variables only need to point the backend
# at that existing instance. The "postgres" service never starts there.

# Hostname the backend connects to for the application database
# (container-to-container, internal port 5432 — not the host-exposed
# DB_PORT above).
# dev: "postgres" (the Docker Compose service name on the vca-net network).
# staging/prod: the VPS host/IP or internal DNS name of the existing DB.
APP_DB_HOST=postgres

# Name of the database used for application data.
# Must be unique per environment (e.g. vca_pos_dev, vca_pos_staging, vca_pos_prod).
APP_DB_NAME=vca_pos_dev

# Database user the backend authenticates with.
APP_DB_USERNAME=vca_pos_user

# Password for the application database user above.
# Never commit real values — keep this only in .env (gitignored).
APP_DB_PASSWORD=changeme

# ============================================
# Frontend (staging/prod only)
# ============================================
# In dev, the frontend is NOT run via Docker — use `npm run dev` inside
# apps/frontend instead (see apps/frontend/README.md). This section only
# applies to staging/prod, where infra/docker-compose.yml builds the Vite
# app and serves it with nginx (service "frontend", profiles staging/prod).
#
# The landing page is currently fully static (no API calls, no auth), so no
# VITE_* build variables are required for it to render. When the menu is
# wired to the backend or Keycloak login is implemented, VITE_* vars will be
# added here — note those are baked in at build time, so each environment
# needs its own image build if their values differ (can't promote the same
# image from staging to prod like a typical container).

# Host port mapped to the frontend container's nginx (80).
FRONTEND_PORT=8082