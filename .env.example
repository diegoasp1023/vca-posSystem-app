# ============================================
# Environment identifier
# ============================================
# Which environment this config belongs to.
# Used to select the docker-compose behavior and naming (dev | staging | prod)
APP_ENV=dev

# Startup command Keycloak runs.
# Use "start-dev" for local/dev (relaxed HTTP, auto-reload, NOT for production).
# Use "start" for staging/prod (stricter checks, still builds its config at
# every boot). Do NOT use "start --optimized" unless infra/docker-compose.yml
# is changed to pre-build the Keycloak image via `kc.sh build` first — the
# stock quay.io/keycloak/keycloak image this project uses was never built,
# so "--optimized" fails outright on first boot instead of just warning.
KC_COMMAND=start-dev

# ============================================
# Shared Postgres server (all environments)
# ============================================
# app-db and Keycloak's DB live as two separate databases inside ONE
# Postgres 16.14 container, deployed the same way in every environment via
# infra/docker-compose.db.yml (only the env file passed to it changes).
# DB_ROOT_USER/DB_ROOT_PASSWORD are only used once, on first startup, by
# infra/postgres-init/init-databases.sh to create the APP_DB_* and KC_DB_*
# databases/users below.
DB_ROOT_USER=postgres_root

# Never commit real values — keep this only in .env (gitignored).
DB_ROOT_PASSWORD=changeme

# Host port mapped to the Postgres container's internal port (5432), bound
# to 127.0.0.1 only (see infra/docker-compose.db.yml) — reachable from the
# host itself (psql, a GUI client, an SSH tunnel) in every environment, but
# never from the network.
DB_PORT=5432

# ============================================
# Database connection (Keycloak's own DB)
# ============================================
# Hostname Keycloak connects to for its own DB (container-to-container,
# internal port 5432 — not the host-exposed DB_PORT above). Always
# "postgres" in every environment: infra/docker-compose.db.yml gives the
# Postgres container that network alias regardless of APP_ENV.
KC_DB_HOST=postgres

# Name of the database Keycloak will use to store its own data
# (realms, users, clients, sessions, etc.). Must already exist and be empty.
KC_DB_NAME=keycloak_dev

# Database user Keycloak will authenticate with.
# Needs privileges to create/alter/drop tables on first boot.
KC_DB_USERNAME=keycloak_user

# Password for the database user above.
# Never commit real values — keep this only in .env (gitignored).
KC_DB_PASSWORD=changeme

# ============================================
# Keycloak admin bootstrap credentials
# ============================================
# Username for the initial Keycloak admin account.
# Only used the first time the container starts with an empty DB.
KEYCLOAK_ADMIN_USER=admin

# Password for the initial Keycloak admin account.
# Change this immediately after first login in staging/prod.
KEYCLOAK_ADMIN_PASSWORD=changeme

# Also required so scripts/setup_keycloak.py can authenticate against
# Keycloak's admin API when run inside the backend container (staging/prod,
# via `docker compose exec backend ...`) — infra/docker-compose.yml passes
# KEYCLOAK_ADMIN_USER/KEYCLOAK_ADMIN_PASSWORD through to that container for
# this reason; the script does not read the app's own .env some other way.

# ============================================
# Network / exposure
# ============================================
# Public hostname Keycloak will be served under.
# Used to build correct redirect URIs and issuer URLs.
# Example: localhost (dev), auth-staging.tudominio.com, auth.tudominio.com
KC_HOSTNAME=localhost

# Host port mapped to Keycloak's internal port (8080).
# Change if 8080 is already taken on the VPS.
KC_PORT=8080

# Realm name used to build the backend's JWT issuer/JWKS URLs
# (http://KC_HOSTNAME:KC_PORT/realms/KC_REALM/...) — must match the realm
# scripts/setup_keycloak.py provisions ("valiente-cafe" in every
# environment). If unset, docker-compose substitutes an empty string here
# instead of leaving it unset, which silently breaks JWT validation instead
# of falling back to the app's Python default — always set it explicitly.
KC_REALM=valiente-cafe

# Hostname scripts/setup_keycloak.py uses to reach Keycloak's admin API,
# separate from KC_HOSTNAME (which is the *public* hostname baked into
# issued tokens). dev: leave unset — the script runs on the host machine, so
# it falls back to KC_HOSTNAME ("localhost"), which is correct there.
# staging/prod: "keycloak" — the script runs inside the backend container
# via `docker compose exec`, where Keycloak is only reachable through the
# Docker network alias, not the public hostname.
KC_ADMIN_HOSTNAME=

# Full public base URL (scheme + host, no trailing slash, no path) that
# ends up in tokens Keycloak issues — must match VITE_KEYCLOAK_URL below.
# dev: leave unset — falls back to "http://KC_HOSTNAME:KC_PORT", correct
# since Keycloak is reached directly with no reverse proxy there.
# staging/prod: required, e.g. "https://auth-staging.example.com" — behind
# Caddy on 443 with no port, a token's real issuer never matches the dev
# fallback ("http://host:8080"), so every request fails JWT validation
# with a silent 401 unless this is set explicitly.
KC_ISSUER_URL=

# ============================================
# Application database (backend/POS data)
# ============================================
# Separate from Keycloak's own database — this one stores business data
# (products, sales, inventory, etc.), never IAM/session data. Lives inside
# the same shared Postgres container as Keycloak's DB (see above), deployed
# identically in every environment via infra/docker-compose.db.yml.

# Hostname the backend connects to for the application database.
# dev: "localhost" — the backend runs locally (not in Docker, see
# apps/backend/README.md), so it reaches Postgres via the host-exposed
# DB_PORT above, not the container network.
# staging/prod: "postgres" — the backend runs containerized there (service
# "backend" in infra/docker-compose.yml) and reaches Postgres by its network
# alias on "vca-net", same as Keycloak does via KC_DB_HOST.
APP_DB_HOST=localhost

# Name of the database used for application data.
# Must be unique per environment (e.g. vca_pos_dev, vca_pos_staging, vca_pos_prod).
APP_DB_NAME=vca_pos_dev

# Database user the backend authenticates with.
APP_DB_USERNAME=vca_pos_user

# Password for the application database user above.
# Never commit real values — keep this only in .env (gitignored).
APP_DB_PASSWORD=changeme

# ============================================
# Backend (staging/prod only)
# ============================================
# In dev, the backend is NOT run via Docker — use `uv run fastapi dev`
# inside apps/backend instead (see apps/backend/README.md). This section
# only applies to staging/prod, where infra/docker-compose.yml builds the
# backend image and runs it as the "backend" service (profiles staging/prod).

# Host port mapped to the backend container's internal port (8000).
BACKEND_PORT=8001

# Allowed CORS origins for the backend API, as a JSON array (matches
# pydantic-settings' parsing for list[str] env vars).
# staging/prod: the frontend's public URL for that environment.
BACKEND_CORS_ORIGINS=["https://app.example.com"]

# Uploaded course images (see apps/backend/app/api/uploads.py) are saved
# to disk at UPLOAD_DIR and served back under /uploads. In staging/prod the
# "backend" service hardcodes UPLOAD_DIR=/data/uploads and mounts a named
# Docker volume ("backend-uploads") at that path, so images survive
# container rebuilds/redeploys — no env var needed here for that.

# ============================================
# Frontend (staging/prod only)
# ============================================
# In dev, the frontend is NOT run via Docker — use `npm run dev` inside
# apps/frontend instead (see apps/frontend/README.md). This section only
# applies to staging/prod, where infra/docker-compose.yml builds the Vite
# app and serves it with nginx (service "frontend", profiles staging/prod).
#
# Host port mapped to the frontend container's nginx (80).
FRONTEND_PORT=8082

# Base URL of the backend API the frontend fetches products/courses from,
# passed as a Docker build ARG to apps/frontend/Dockerfile (see infra/
# docker-compose.yml's "frontend" service build.args).
# staging/prod: wherever that environment's backend is reachable.
# NOT used in dev — Vite only reads its own project's env files
# (apps/frontend/.env.local), not this root one; see apps/frontend/README.md
# for the dev equivalent of this variable.
# IMPORTANT: VITE_* vars are baked into the build at build time (Vite),
# not read at runtime — each environment needs its own image build if this
# value differs; you can't promote the same built image from staging to
# prod like a typical container.
VITE_API_BASE_URL=https://api.example.com

# Keycloak connection the frontend's login button uses (keycloak-js),
# also passed as Docker build ARGs like VITE_API_BASE_URL above.
VITE_KEYCLOAK_URL=https://auth.example.com
VITE_KEYCLOAK_REALM=valiente-cafe
VITE_KEYCLOAK_CLIENT_ID=valiente-cafe-app-frontend